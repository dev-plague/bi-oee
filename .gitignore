# ============================================================
# Datos fuente y documentos de trabajo (NO versionar)
# ============================================================
docs/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/private/*
!data/private/.gitkeep
*.xlsm
*.xlsx
*.xls
*.pdf
!informe/informe.pdf

# ============================================================
# Secretos y configuración local
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ============================================================
# Contenedores / datos locales
# ============================================================
pgdata/
grafana_data/
*.log

# ============================================================
# Power BI (binarios y cachés; el proyecto PBIP sí se versiona)
# ============================================================
*.pbix
*.pbit
*.pbixproj
.pbi/
**/.pbi/
**/cache.abf
**/localSettings.json
**/unappliedChanges.json

# ============================================================
