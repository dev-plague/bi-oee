    {
      "type": "barchart",
      "title": "Pareto de causas de paro (histórico)",
      "datasource": {
        "type": "postgres",
        "uid": "oee-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "oee-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT LEFT(c.nombre, 34) AS causa,\n               ROUND(SUM(f.horas_paro)::numeric, 2) AS horas\n        FROM oee.fact_paro f\n        JOIN oee.dim_codigo_paro c ON c.codigo_key = f.codigo_key\n        WHERE f.tiempo_key >= TO_CHAR(($__timeFrom())::timestamptz, 'YYYYMMDD')::integer\n          AND f.tiempo_key <= TO_CHAR(($__timeTo())::timestamptz, 'YYYYMMDD')::integer\n          AND f.maquina_key IN (\n              SELECT maquina_key FROM oee.dim_maquina\n              WHERE codigo IN (${maquina:sqlstring})\n          )\n        GROUP BY c.nombre\n        ORDER BY horas DESC\n        LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "causa",
        "yField": "horas",
        "showValue": "auto",
        "stacking": "none",
        "legend": {
