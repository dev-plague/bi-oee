          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT hora AS \"time\", maquina AS metric, oee\n        FROM oee.vw_oee_hora\n        WHERE $__timeFilter(hora)\n          AND maquina IN (${maquina:sqlstring})\n        ORDER BY 1"
