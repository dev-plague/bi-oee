    {
      "type": "table",
      "title": "Estado actual por máquina",
      "datasource": {
        "type": "postgres",
        "uid": "oee-postgres"
      },
      "gridPos": {
        "x": 14,
        "y": 6,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "oee-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT maquina,\n               estado,\n               ROUND(oee * 100, 1)            AS \"OEE %\",\n               ROUND(disponibilidad * 100, 1) AS \"Disp %\",\n               ROUND(rendimiento * 100, 1)    AS \"Rend %\",\n               ROUND(minutos_paro, 1)         AS \"Paro min\",\n               ultima_actualizacion\n        FROM oee.vw_estado_actual_maquina\n        WHERE maquina IN (${maquina:sqlstring})\n        ORDER BY maquina"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
