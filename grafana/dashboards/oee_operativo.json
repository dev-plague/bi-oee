          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "oee-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(\n                 SUM(f.unidades_producidas) / NULLIF(SUM(f.minutos_planificados) * 72, 0),\n                 0\n               ) AS oee\n        FROM oee.fact_produccion_hora f\n        JOIN oee.dim_maquina m ON m.maquina_key = f.maquina_key\n        WHERE f.ts_hora >= NOW() - INTERVAL '15 minutes'\n          AND m.codigo IN (${maquina:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
