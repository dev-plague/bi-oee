    {
      "type": "barchart",
      "title": "OEE por turno (histórico)",
      "datasource": {
        "type": "postgres",
        "uid": "oee-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "oee-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT turno,\n               ROUND(\n                 (SUM(horas_operativas_ref) / NULLIF(SUM(horas_trabajadas_ref), 0))\n                 * LEAST(SUM(unidades_producidas) / NULLIF(SUM(minutos_ideales_operativos), 0), 1.0)\n                 * 100, 1\n               ) AS \"OEE %\"\n        FROM oee.vw_oee_turno\n        WHERE turno IN (${turno:sqlstring})\n          AND periodo_anio_mes >= TO_CHAR(($__timeFrom())::timestamptz, 'YYYY-MM')\n        GROUP BY turno\n        ORDER BY \"OEE %\" DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
