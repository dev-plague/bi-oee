# ============================================================
# Plantilla de variables de entorno. Copiar a .env y cambiar
# TODOS los valores. El archivo .env NO se versiona.
# ============================================================

# --- PostgreSQL -------------------------------------------------
POSTGRES_DB=oee_bi
POSTGRES_USER=oee_admin
POSTGRES_PASSWORD=cambia_esto_admin
POSTGRES_PORT=5432

# Roles de mínimo privilegio creados por db/init/00_roles.sh
OEE_ETL_PASSWORD=cambia_esto_etl
OEE_BI_PASSWORD=cambia_esto_bi
OEE_GRAFANA_PASSWORD=cambia_esto_grafana

# --- Grafana ----------------------------------------------------
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambia_esto_grafana_admin

# --- ETL --------------------------------------------------------
# Ruta del .xlsm dentro del contenedor (volumen ./data:/data)
SOURCE_XLSM=/data/raw/SEGUIMIENTO TEMPERAS Y VINILOS Actividad.xlsm
# Sal para seudonimizar nombres de operarias y personal de mantenimiento.
# Usar una cadena larga y aleatoria; si cambia, cambian los seudónimos.
PII_SALT=cambia_esto_por_una_sal_larga_y_aleatoria

# --- Simulador near real-time ----------------------------------
# Cada cuántos segundos inserta una "hora" simulada
SIM_INTERVAL=2
# Probabilidad de inyectar una anomalía (0.0 a 1.0)
SIM_ANOMALY_PROB=0.05
# Umbral de alerta de OEE (0.60 = 60 %)
OEE_ALERT_THRESHOLD=0.60
