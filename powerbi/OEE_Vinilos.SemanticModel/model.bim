      {
        "name": "_Medidas",
        "columns": [
          {
            "name": "Valor",
            "dataType": "string",
            "sourceColumn": "[Valor]",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_Medidas",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ROW(\"Valor\", \"\")"
            }
          }
        ],
        "measures": [
          {
            "name": "OEE %",
            "expression": "VAR d = [Disponibilidad %]\nVAR r = [Rendimiento %]\nVAR c = [Calidad %]\nRETURN d * MIN(r, 1) * c",
            "formatString": "0.0%",
            "displayFolder": "OEE",
            "description": "OEE con tope de rendimiento al 100 %."
          },
          {
            "name": "Disponibilidad %",
            "expression": "DIVIDE ( SUM ( vw_oee_diario_maquina[horas_operativas_ref] ), SUM ( vw_oee_diario_maquina[horas_trabajadas_ref] ) )",
            "formatString": "0.0%",
            "displayFolder": "OEE",
            "description": "Horas operativas / horas trabajadas, sobre registros con referencia conocida."
          },
          {
            "name": "Rendimiento %",
            "expression": "DIVIDE ( SUM ( vw_oee_diario_maquina[unidades_producidas] ), SUM ( vw_oee_diario_maquina[minutos_ideales_operativos] ) )",
            "formatString": "0.0%",
            "displayFolder": "OEE",
            "description": "Unidades producidas / unidades ideales en el tiempo operativo."
          },
          {
            "name": "Calidad %",
            "expression": "1",
            "formatString": "0.0%",
            "displayFolder": "OEE",
            "description": "La fuente no captura rechazos; se asume 100 % y se documenta como limitación."
          },
          {
            "name": "OEE YTD %",
            "expression": "TOTALYTD ( [OEE %], dim_tiempo[fecha] )",
            "formatString": "0.0%",
            "displayFolder": "OEE",
            "description": "OEE acumulado del año."
          },
          {
            "name": "OEE Año Anterior %",
            "expression": "CALCULATE ( [OEE %], SAMEPERIODLASTYEAR ( dim_tiempo[fecha] ) )",
            "formatString": "0.0%",
            "displayFolder": "OEE",
            "description": "OEE del mismo periodo del año anterior."
          },
          {
            "name": "Var OEE YoY pp",
            "expression": "[OEE %] - [OEE Año Anterior %]",
            "formatString": "0.0%",
            "displayFolder": "OEE",
            "description": "Variación en puntos porcentuales."
          },
          {
            "name": "Var OEE YoY %",
            "expression": "DIVIDE ( [OEE %] - [OEE Año Anterior %], [OEE Año Anterior %] )",
            "formatString": "0.0%",
            "displayFolder": "OEE",
            "description": "Variación relativa."
          },
          {
            "name": "Horas Paro",
            "expression": "SUM ( fact_paro[horas_paro] )",
            "formatString": "0.0",
            "displayFolder": "Paros",
            "description": "Horas de paro."
          },
          {
            "name": "Eventos Paro",
            "expression": "COUNTROWS ( fact_paro )",
            "formatString": "0",
            "displayFolder": "Paros",
            "description": "Número de eventos de paro."
          },
          {
            "name": "MTBF (h)",
            "expression": "DIVIDE ( SUM ( vw_mtbf_mttr[horas_operativas] ), SUM ( vw_mtbf_mttr[fallas] ) )",
            "formatString": "0.00",
            "displayFolder": "Mantenimiento",
            "description": "Tiempo medio entre fallas no programadas."
          },
          {
            "name": "MTTR (h)",
            "expression": "DIVIDE ( SUM ( vw_mtbf_mttr[horas_paro_no_programado] ), SUM ( vw_mtbf_mttr[fallas] ) )",
            "formatString": "0.00",
            "displayFolder": "Mantenimiento",
            "description": "Tiempo medio de reparación."
          },
          {
            "name": "Unidades Producidas",
            "expression": "SUM ( vw_oee_diario_maquina[unidades_producidas] )",
            "formatString": "#,0",
            "displayFolder": "Producción"
          },
          {
            "name": "Pacas Producidas",
            "expression": "SUM ( vw_oee_diario_maquina[pacas] )",
            "formatString": "#,0",
            "displayFolder": "Producción"
          },
          {
            "name": "Cobertura Referencia %",
            "expression": "DIVIDE ( SUM ( vw_oee_diario_maquina[horas_trabajadas_ref] ), SUM ( vw_oee_diario_maquina[horas_trabajadas] ) )",
            "formatString": "0.0%",
            "displayFolder": "OEE",
            "description": "Porcentaje de horas con referencia conocida; indica confiabilidad del OEE."
          },
          {
            "name": "Pareto % Acumulado",
            "expression": "VAR actual = [Horas Paro]\nVAR total = CALCULATE ( [Horas Paro], ALLSELECTED ( dim_codigo_paro ) )\nVAR acum = CALCULATE ( [Horas Paro], FILTER ( ALLSELECTED ( dim_codigo_paro ), [Horas Paro] >= actual ) )\nRETURN DIVIDE ( acum, total )",
            "formatString": "0.0%",
            "displayFolder": "Paros",
            "description": "Porcentaje acumulado para el Pareto de causas."
          },
          {
            "name": "Semáforo OEE",
            "expression": "SWITCH ( TRUE (), [OEE %] >= 0.85, \"🟢 Verde\", [OEE %] >= 0.75, \"🟡 Amarillo\", [OEE %] >= 0.60, \"🟠 Naranja\", \"🔴 Rojo\" )",
            "formatString": "@",
            "displayFolder": "OEE",
            "description": "Clasificación cualitativa del OEE."
          },
          {
            "name": "OEE vs Meta pp",
            "expression": "[OEE %] - 0.75",
            "formatString": "0.0%",
            "displayFolder": "OEE",
            "description": "Diferencia contra la meta de 75 %."
          },
          {
            "name": "OEE Referencia %",
            "expression": "DIVIDE ( SUM ( fact_produccion[unidades_producidas] ), SUM ( fact_produccion[minutos_ideales] ) )",
            "formatString": "0.0%",
            "displayFolder": "OEE",
            "description": "OEE calculado a nivel de referencia (sin asignar paros)."
          }
        ]
      }
    ],
