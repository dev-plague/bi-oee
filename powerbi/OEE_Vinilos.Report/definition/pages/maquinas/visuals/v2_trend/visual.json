                }
              },
              "queryRef": "dim_tiempo.periodo_anio_mes",
              "nativeQueryRef": "periodo_anio_mes"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Medidas"
                    }
                  },
                  "Property": "OEE YTD %"
                }
              },
              "queryRef": "_Medidas.OEE YTD %",
              "nativeQueryRef": "OEE YTD %"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_maquina"
                    }
                  },
                  "Property": "codigo"
                }
              },
              "queryRef": "dim_maquina.codigo",
              "nativeQueryRef": "codigo"
